PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/habitforge
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
# Demo-only: lets POST /api/billing/upgrade flip isPremium without a payment provider.
ALLOW_DEMO_BILLING=true
# Timezone used by the seed script for the Demo User
SEED_TIMEZONE=Asia/Kolkata
